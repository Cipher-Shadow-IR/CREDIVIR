# ==== Hardhat deployment secrets (local, git-ignored) ====
# Copy this file to ".env" in the project root and fill in values.
# The real .env file is git-ignored and must NEVER be committed.

# Public Sepolia RPC endpoint (e.g. Alchemy / Infura / a public Sepolia RPC).
# Used by scripts/deploy.cjs (Hardhat deployer).
SEPOLIA_RPC_URL=

# Deployer wallet private key - TESTNET ONLY. Fund it with a Sepolia faucet.
PRIVATE_KEY=

# ==== Frontend build-time vars (Vite) ====
# These are read via import.meta.env in src/lib/blockchain.ts and are
# required for the deployed frontend to talk to the contract.
# Set the same names in Vercel: Settings => Environment Variables.

# Deployed CertificateVerification.sol address on Sepolia.
VITE_CONTRACT_ADDRESS=

# The deployer/admin wallet address (used for the admin UI check).
VITE_ADMIN_WALLET_ADDRESS=

# Public Sepolia RPC for read-only verification from the browser.
VITE_SEPOLIA_RPC_URL=